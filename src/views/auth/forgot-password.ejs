<%- include('../partials/head') %>
<main class="auth-page">
  <section class="auth-panel">
    <h1>Esqueci minha senha</h1>
    <p>Informe sua matricula para iniciar a redefinicao.</p>
    <form action="/senha/esqueci" method="post" class="form">
      <label>
        Matricula
        <input type="text" name="registration" autocomplete="username" required>
      </label>
      <button class="button button-primary" type="submit">Solicitar redefinicao</button>
    </form>
    <a class="muted-link" href="/login">Voltar ao login</a>
  </section>
</main>
</body>
</html>
