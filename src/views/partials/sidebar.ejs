<aside class="sidebar">
  <div class="sidebar-header">
    <div class="brand">
      <span class="brand-mark">SC</span>
      <div class="brand-text">
        <strong>Contratos</strong>
      </div>
    </div>

    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Recuar menu lateral" aria-pressed="false">
      <span aria-hidden="true"></span>
    </button>
  </div>

  <nav class="nav">
    <a href="/dashboard" data-short="D" class="<%= title === 'Dashboard' ? 'active' : '' %>"><span>Dashboard</span></a>
    <% if (currentUser && currentUser.permissions.includes('dashboards.view')) { %>
      <a href="/dashboard/gerencia" data-short="G" class="<%= title === 'Dashboard Gerencial' ? 'active' : '' %>"><span>Gerencial</span></a>
    <% } %>
    <a href="/contratos" data-short="C" class="<%= title === 'Contratos' || String(title || '').startsWith('Contrato ') ? 'active' : '' %>"><span>Contratos</span></a>
    <a href="/pendencias" data-short="P" class="<%= title === 'Pendencias' ? 'active' : '' %>"><span>Pendencias</span></a>
    <a href="/notificacoes" data-short="A" class="<%= title === 'Notificacoes' ? 'active' : '' %>"><span>Alertas</span></a>
    <% if (currentUser && currentUser.permissions.includes('imports.manage')) { %>
      <a href="/importacoes" data-short="I" class="<%= title === 'Importar Dados' || title === 'Previa da Importacao' ? 'active' : '' %>"><span>Importar Dados</span></a>
    <% } %>
    <% if (currentUser && currentUser.permissions.includes('reports.view')) { %>
      <a href="/relatorios" data-short="R" class="<%= title === 'Relatorios' ? 'active' : '' %>"><span>Relatorios</span></a>
    <% } %>
    <% if (currentUser && currentUser.permissions.includes('settings.manage')) { %>
      <a href="/configuracoes" data-short="CF" class="<%= title === 'Configuracoes' ? 'active' : '' %>"><span>Configuracoes</span></a>
      <a href="/admin/saude-da-base" data-short="SB" class="<%= title === 'Saude da Base' ? 'active' : '' %>"><span>Saude da Base</span></a>
    <% } %>
    <% if (currentUser && currentUser.permissions.includes('users.manage')) { %>
      <a href="/usuarios" data-short="AD" class="<%= title === 'Usuarios' ? 'active' : '' %>"><span>Administracao</span></a>
    <% } %>
  </nav>

  <div class="sidebar-logo">
    <img src="/images/favsystem-logo.png" alt="Favsystem">
  </div>
</aside>
