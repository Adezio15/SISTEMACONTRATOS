<article class="content-card chart-card">
  <h2><%= title %></h2>
  <% const maxValue = getChartMaxValue(items); %>
  <div class="bar-chart">
    <% if (items.length === 0) { %>
      <p class="muted-text">Sem dados para exibir.</p>
    <% } %>
    <% items.forEach((item) => { %>
      <% const value = Number(item.value || 0); %>
      <% const chartClass = (item.label || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); %>
      <div class="bar-row chart-row-<%= chartClass %>">
        <span class="bar-label"><%= item.label %></span>
        <div class="bar-track">
          <span class="bar-fill" style="width: <%= getBarWidth(value, maxValue) %>%"></span>
        </div>
        <strong><%= value %></strong>
      </div>
    <% }) %>
  </div>
</article>
