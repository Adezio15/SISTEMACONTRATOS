NODE_ENV=development
PORT=3000

# Local PostgreSQL with docker compose.
DATABASE_URL=postgresql://sesc_contratos:local_dev_password@localhost:5432/sesc_contratos
DATABASE_DIRECT_URL=postgresql://sesc_contratos:local_dev_password@localhost:5432/sesc_contratos

# Production Neon PostgreSQL:
# DATABASE_URL must use the pooled connection.
# DATABASE_DIRECT_URL must use the direct connection for migrations/admin operations.
# Both Neon URLs should include sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
TZ=America/Fortaleza
JOBS_ENABLED=false

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
STORAGE_URL=
STORAGE_KEY=

# Optional local seed values. Change before running npm run seed.
SEED_ADMIN_NAME=Administrador do Sistema
SEED_ADMIN_REGISTRATION=admin
SEED_ADMIN_EMAIL=admin@sesc-rn.local
SEED_ADMIN_PASSWORD=Admin@123456

# Optional local app user. Run npm run create-local-user after migrations/seeds.
LOCAL_USER_NAME=Usuario Local
LOCAL_USER_REGISTRATION=local
LOCAL_USER_EMAIL=local@sesc-rn.local
LOCAL_USER_POSITION=Administrador Local
LOCAL_USER_ROLE=ADMINISTRADOR
LOCAL_USER_PASSWORD=Local@123456
